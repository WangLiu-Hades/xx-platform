<?xml version="1.0" encoding="UTF-8"?>
<!--
  多维数据分析平台 · 正式 HTTP API（DEV-01）
  契约唯一来源：contracts/api/openapi.yaml（OpenAPI 3.0.3，版本 1.0.0-dev.4-provisional）
  基线：Java 17 / Spring Boot 3.5.16 / Maven 3.9.x
  说明见同目录 README.md；分工与边界见 docs/project-governance/BACKEND_TWO_DEV_SPLIT.md
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.xxplatform</groupId>
  <artifactId>xx-platform-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>xx-platform-api</name>
  <description>多维数据分析平台正式 HTTP API（DEV-01 后端）</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- 契约生成器：与 contracts/api/api-conventions.md §9 及审计报告一致 -->
    <openapi-generator.version>7.25.0</openapi-generator.version>
    <openapi.spec>${project.basedir}/../../contracts/api/openapi.yaml</openapi.spec>
  </properties>

  <dependencies>
    <!-- Web 层：REST 接口（统一响应壳、异常兜底、traceId 过滤都在这里落地） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 契约字段校验：@Valid / @NotNull / @Pattern，对应 Schema 的 required/enum/pattern -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      持久化：Spring JDBC + PostgreSQL 驱动。

      为什么用 JdbcTemplate 而不是 JPA/MyBatis：
        - 契约的 DDL 已经写死（163 表、复合主键、部分唯一索引、触发器），
          JPA 的自动 DDL / 实体映射会与它打架，而且复合主键、`text[]`、geometry
          这些类型映射成本远高于直接写 SQL；
        - 本项目的读路径大量依赖部分索引谓词（`WHERE deleted=false`）和
          `FOR UPDATE SKIP LOCKED`，这些在 JdbcTemplate 下是透明 SQL，
          在 ORM 里要么做不到要么要绕；
        - 分工方案要求"不允许跨包直接写他人的表"，显式 SQL 让越界一眼可见。

      注意：数据源只在 `db` profile 下启用（见 application-db.yml）。
      默认启动不连数据库，`mvn test` / `mvn compile` 在没有数据库的机器上仍然可用。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Flyway 运行期依赖（与 `db-migrate` profile 里的 flyway-maven-plugin 是**两回事**）。

      为什么要运行期也带上：
        - 启动时自动补齐迁移，本地开发只要带上 db profile 即可，
          不必先记着跑 `mvn -Pdb-migrate flyway:migrate`；
        - 应用启动会先 `validate` 历史表，**版本号或校验和漂移会让进程启动失败**，
          而不是带着半旧的库继续对外服务——这是比"记得手动迁移"更强的保证。

      为什么不会被默认构建拖累：
        FlywayAutoConfiguration 只在存在 DataSource 时生效，而数据源只在 `db` profile 下
        配置（application-db.yml）。不带该 profile 启动时 Flyway 完全不参与。

      并发安全：Flyway 在 `flyway_schema_history` 上取咨询锁，多实例同时启动只有一个
      真正执行，其余等待。因此不需要额外的"谁先迁移"编排。

      `flyway-database-postgresql` 是 Flyway 10+ 拆出来的模块，缺了它 PG 方言不被识别
      （报 "Unsupported Database: PostgreSQL"）。
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!--
      以下依赖按分工分阶段加入，当前故意不引入，避免骨架跑不起来：
      - spring-session-jdbc：SID Cookie 会话（按 P-001 暂定方案；当前自己管理 auth.user_session）
      - spring-boot-starter-data-redis：幂等键/游标/限流缓存（按需，首版按设计不引入）
      - spring-boot-starter-actuator：契约已自带 /health、/ready，不叠加 agent 端点
    -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      契约生成 profile：`mvn -Pgenerate-api generate-sources`

      为什么单独放 profile，而不是放进默认 build：
      插件本身需要联网下载（本机与 CI 的离线环境跑默认构建时会直接失败，
      并连带影响本来能编译的代码）。放在 profile 里之后：
        - 默认 `mvn compile` / `mvn package` 完全离线可用；
        - 需要生成或更新契约产物时显式加 -Pgenerate-api，并确保能访问 Maven 仓库。

      配置必须与契约 info.x-codegen.spring 及 contracts/api/api-conventions.md §9 一致。
      生成物进入 target/generated-sources/openapi（target 下，mvn clean 会清除，不提交）。
    -->
    <profile>
      <id>generate-api</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openapitools</groupId>
            <artifactId>openapi-generator-maven-plugin</artifactId>
            <version>${openapi-generator.version}</version>
            <executions>
              <execution>
                <id>generate-api-from-contract</id>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <inputSpec>${openapi.spec}</inputSpec>
                  <generatorName>spring</generatorName>
                  <output>${project.build.directory}/generated-sources/openapi</output>
                  <apiPackage>com.xxplatform.api.generated.api</apiPackage>
                  <modelPackage>com.xxplatform.api.generated.model</modelPackage>
                  <invokerPackage>com.xxplatform.api.generated.invoker</invokerPackage>
                  <generateApiTests>false</generateApiTests>
                  <generateModelTests>false</generateModelTests>
                  <generateApiDocumentation>false</generateApiDocumentation>
                  <generateModelDocumentation>false</generateModelDocumentation>
                  <!--
                    nameMappings 是**插件 mojo 级参数**（List<String>，映射"属性名"），
                    不是 configOptions 里的一项。放在 configOptions 里会被**静默忽略**，
                    生成物完全不改名——契约文档写的就是这个映射，但写法必须在这里。

                    为什么需要它：契约 Schema `SetTaskCreated` 同时有 `setTaskId` 和 `taskId`
                    两个属性。默认生成会给 `setTaskId` 属性生成 setter `setTaskId(...)`，
                    与 `taskId` 属性的 setter 同名同参 → 重复方法 → 编译失败
                    （综合测试报告 2026-10-16 的"生成后编译失败"实际包含这一条，
                     不只是缺 swagger 依赖）。

                    映射后：`setTaskId` 属性 → `setOperationId(...)` / `setSetOperationId(...)`；
                    `taskId` 属性 → `setTaskId(...)`。JSON 报文两侧仍是 setTaskId / taskId，
                    只改 Java 方法名，不动物线上字段名。
                  -->
                  <nameMappings>
                    <param>setTaskId=setOperationId</param>
                  </nameMappings>
                  <configOptions>
                    <interfaceOnly>true</interfaceOnly>
                    <useSpringBoot3>true</useSpringBoot3>
                    <useOneOfInterfaces>true</useOneOfInterfaces>
                    <useTags>true</useTags>
                    <dateLibrary>java8</dateLibrary>
                    <openApiNullable>false</openApiNullable>
                    <performBeanValidation>true</performBeanValidation>
                    <!--
                      让生成物"自包含"，不引入 io.swagger 注解依赖。

                      spring generator 默认会在每个接口方法上生成 @Operation/@ApiResponse，
                      这些注解来自 io.swagger.core.v3:swagger-annotations-jakarta。
                      综合测试报告 2026-10-16 报的"生成后编译失败"就是这个原因：
                      生成出了 Java 文件，但项目没有该依赖。

                      三种解法里选了"关闭注解生成"：
                        1) 补 swagger-annotations 依赖 → 默认构建（含离线）依赖它，风险高；
                        2) 只给一个 stub jar → 运行期若有代码反射注解会踩空，且不知注解版本；
                        3) 关闭注解生成（本方案）→ 生成物只依赖 spring-web + validation，
                           离线可编译，且不影响 interfaceOnly 的签名/校验契约。

                      代价：接口上没有 OpenAPI 注解。这是可接受的——契约文档的唯一来源是
                      contracts/api/openapi.yaml 本身，不靠 Java 注解二次维护；
                      而且下面本来就把 generateApiDocumentation 关掉了。
                      annotationLibrary=none 只用 spring-web/validation 注解；
                      documentationProvider=none 去掉 @Operation/@ApiResponse 生成。
                    -->
                    <annotationLibrary>none</annotationLibrary>
                    <documentationProvider>none</documentationProvider>
                  </configOptions>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      数据库迁移 profile：`mvn -Pdb-migrate flyway:migrate`

      为什么用 profile 而不是默认 build：
        1. 默认 `mvn compile` 必须能在没有数据库、没有联网的机器上跑通；
        2. 迁移是**部署动作**，不是编译动作，不应该在 `mvn package` 时顺手改库；
        3. flyway 插件与 JDBC 驱动需要下载，放进默认 build 会拖累离线构建
           （和 generate-api 同样的理由）。

      版本：flyway 版本交给 spring-boot-starter-parent 管理（Boot 3.5.16 → 11.7.2），
            不要在这里写死，否则升级 Boot 时会漂移。

      ⚠ Flyway 10+ 把数据库支持拆成独立模块，PostgreSQL 必须额外加
        `org.flywaydb:flyway-database-postgresql`，否则报
        "No database found to handle jdbc:postgresql:..."。这是最常见的踩坑点。

      用法（口令不要写进仓库，用环境变量传）：
        $env:DB_URL='jdbc:postgresql://127.0.0.1:5432/xxplatform'
        $env:DB_USER='xxplatform_owner'
        $env:DB_PASSWORD='...'
        mvn -Pdb-migrate flyway:migrate
    -->
    <profile>
      <id>db-migrate</id>
      <properties>
        <db.url>${env.DB_URL}</db.url>
        <db.user>${env.DB_USER}</db.user>
        <db.password>${env.DB_PASSWORD}</db.password>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-maven-plugin</artifactId>
            <configuration>
              <url>${db.url}</url>
              <user>${db.user}</user>
              <password>${db.password}</password>
              <!-- 迁移脚本与 schema.sql 基线一起放在 resources 下，随 jar 发布 -->
              <locations>
                <location>filesystem:${project.basedir}/src/main/resources/db/migration</location>
              </locations>
              <!-- 空库首次迁移：允许在非空库上以基线方式接管（见 README §迁移） -->
              <baselineOnMigrate>true</baselineOnMigrate>
              <baselineVersion>0</baselineVersion>
              <validateOnMigrate>true</validateOnMigrate>
              <cleanDisabled>true</cleanDisabled>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
              </dependency>
              <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
              </dependency>
            </dependencies>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
