# apps/api 数据库连接与环境变量（示例）
#
# 用法：复制为 .env.local 并填入真实值；.env / .env.* 已被 .gitignore 排除，
# 只有本 .example 会进仓库。**不要把真实口令写进 .env.example。**
#
#   Copy-Item .env.example .env.local
#   # 编辑 .env.local
#   # 在 PowerShell 里加载（.env 不会自动生效，需显式导入）：
#   Get-Content .env.local | Where-Object { $_ -match '^[A-Z_]+=' } | ForEach-Object {
#       $k, $v = $_ -split '=', 2
#       [Environment]::SetEnvironmentVariable($k, $v, 'Process')
#   }
#
# 然后：mvn -Pdb-migrate flyway:migrate

# ---------------------------------------------------------------- 迁移（Flyway）
# 迁移专用账号：建表、改 schema。与将来 app/Worker 的运行账号隔离。
DB_URL=jdbc:postgresql://127.0.0.1:5432/xxplatform
DB_USER=xxplatform_owner
DB_PASSWORD=change-me

# ---------------------------------------------------------------- provisioning（一次性）
# 只有 `scripts/db-provision.ps1` 用得到，必须是超级用户口令。
# 日常迁移不需要它，用完请从当前会话清除。
PGSUPERUSER_PASSWORD=change-me-superuser

# ---------------------------------------------------------------- 应用运行期（已在任务 4/5 启用）
# 带 `db` profile 启动时才连库：mvn spring-boot:run "-Dspring-boot.run.profiles=db"
# 运行账号应为独立角色，只有数据读写权限，不能改 schema。
# SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/xxplatform
# SPRING_DATASOURCE_USERNAME=xxplatform_app
# SPRING_DATASOURCE_PASSWORD=change-me

# ---------------------------------------------------------------- 开发种子账号（仅本地/开发环境）
# 前端联调要一个能登录的账号（demo.admin）。两个都给了才会创建：
# 开启开关 + 口令（口令只从环境变量读，yml 里没有）。口令短于 8 位会启动即失败。
# 会建三个账号 + 三个角色（三种权限档，用于验证权限分支）：
#   demo.admin    → SUPER_ADMIN，全部 58 个权限码，ownOnly=false，四种 dataType
#   demo.operator → OPERATOR，13 个只读权限，ownOnly=true，仅 FENCE/PLATE
#   demo.classified → CLASSIFIED，15 个（operator + capture:decrypt + audit:read）
# 登录名可用 XX_AUTH_DEVSEED_LOGINNAME / _OPERATORLOGINNAME / _CLASSIFIEDLOGINNAME 覆盖。
# 生产环境永远不要打开。
# XX_AUTH_DEVSEED_ENABLED=true
# XX_AUTH_DEVSEED_PASSWORD=change-me-at-least-8-chars

# 账号已存在时是否重置口令。默认 false（正常重启不冲掉手工改过的口令）。
# 换口令后必须显式打开一次，否则新口令只对新建账号生效，老账号仍是旧口令；
# 打开时会把该用户未撤销的会话一并撤销（改锁必须换钥匙）。
# XX_AUTH_DEVSEED_RESETPASSWORD=false

# ---------------------------------------------------------------- 其他
# traceId 透传（默认 false，仅在可信网关后面才开）
# XX_TRACE_ACCEPT_CLIENT_TRACE_ID=false

# 会话 TTL（契约 SessionData 仍是 pending/P-001，所以做成配置项）
# XX_SESSION_IDLE_TTL=30m
# XX_SESSION_ABSOLUTE_TTL=12h
# SID Cookie 的 Secure 属性：本地 http 调试必须 false（浏览器不回传 Secure Cookie），
# 生产（HTTPS）必须 true。
# XX_SESSION_SECURE_COOKIE=false

# 登录频控（进程内滑动窗口；多实例时实际阈值 = 实例数 × MAX_FAILURES）
# XX_AUTH_THROTTLE_MAX_FAILURES=10
# XX_AUTH_THROTTLE_WINDOW=15m
# XX_AUTH_THROTTLE_LOCKOUT=15m
