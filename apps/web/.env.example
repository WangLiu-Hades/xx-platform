# Mock demonstrations use no remote data or commands.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1
# For backend integration: copy to .env.local, set VITE_API_MODE=http.
# API_PROXY_TARGET=http://127.0.0.1:8080

# —— 智能体本地大模型（OpenAI 兼容接口，默认指向本机 Ollama）——
# 只接受本机/内网地址；关闭后智能体仍用内置规则引擎完成识别与跳转。
VITE_LLM_ENABLED=true
VITE_LLM_BASE_URL=http://127.0.0.1:11434/v1
VITE_LLM_MODEL=qwen2.5:7b-instruct
# 本地 Ollama 通常不需要；vLLM 等如需鉴权再填。
# VITE_LLM_API_KEY=
