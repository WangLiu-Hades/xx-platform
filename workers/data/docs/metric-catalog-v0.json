  "openContractIssues": [
    {
      "id": "D3-C01",
      "owner": "DEV-01",
      "description": "ReportDefinition periodEnd 含自然周期；DDL period_start<period_end 不接受显式同日起止。需确认存储转排他上界还是迁移，当前不改权威契约。"
    },
    {
      "id": "D3-C02",
      "owner": "DEV-01/业务",
      "description": "DeviceCapturePoint/Statistics 的采集计数为必填非空整数，缺少源端计数时不能返回0或null冒充；P-006未签认时保留能力不可用/REQUIREMENT_PENDING。"
    },
    {
      "id": "D3-C03",
      "owner": "DEV-01/DEV-03",
      "description": "合成 ingestedAt/processed_at 使用批次 receivedAt，不是实测提交时间；不能用于生产入库时延和日入库趋势。"
    }
  ]
