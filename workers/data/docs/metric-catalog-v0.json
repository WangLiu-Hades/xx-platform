{
  "schemaVersion": "d3-metric-catalog-v0",
  "approvalStatus": "DEV3_DRAFT",
  "asOf": "2026-10-16",
  "scope": "工程计数可离线复验；业务指标及八类报表尚未签认",
  "metrics": [
    {
      "code": "D3_PROCESSING_ROWS",
      "name": "处理行数",
      "unit": "row",
      "formula": "每个已提交 batchId + 物理 rowNumber 计一次",
      "status": "LOCAL_ENGINEERING_ONLY",
      "definitionVersion": "d3-engineering-metrics-v0",
      "enabledInPlatform": false,
      "implementedInOfflineAudit": true,
      "additiveAcrossDisjointBatchSets": true,
      "aggregationNote": "仅不重叠批次可求和；相同批次重试不追加",
      "references": [
        {
          "table": "capture.ingestion_item",
          "columns": [
            "processing_status"
          ]
        }
      ]
    },
    {
      "code": "D3_ACCEPTED_ROWS",
      "name": "首次接纳行数",
      "unit": "row",
      "formula": "processing_status=ACCEPTED 的逐行结果数",
      "status": "LOCAL_ENGINEERING_ONLY",
      "definitionVersion": "d3-engineering-metrics-v0",
      "enabledInPlatform": false,
      "implementedInOfflineAudit": true,
      "additiveAcrossDisjointBatchSets": true,
      "aggregationNote": "仅不重叠批次可求和；相同批次重试不追加",
      "references": [
        {
          "table": "capture.ingestion_item",
          "columns": [
            "processing_status"
          ]
        }
      ]
    },
    {
      "code": "D3_DUPLICATE_ROWS",
      "name": "重复行数",
      "unit": "row",
      "formula": "processing_status=DUPLICATE 的逐行结果数",
      "status": "LOCAL_ENGINEERING_ONLY",
      "definitionVersion": "d3-engineering-metrics-v0",
      "enabledInPlatform": false,
      "implementedInOfflineAudit": true,
      "additiveAcrossDisjointBatchSets": true,
      "aggregationNote": "仅不重叠批次可求和；相同批次重试不追加",
      "references": [
        {
          "table": "capture.ingestion_item",
          "columns": [
            "processing_status"
          ]
        }
      ]
    },
    {
      "code": "D3_REJECTED_ROWS",
      "name": "拒绝行数",
      "unit": "row",
      "formula": "processing_status=REJECTED 的逐行结果数",
      "status": "LOCAL_ENGINEERING_ONLY",
      "definitionVersion": "d3-engineering-metrics-v0",
      "enabledInPlatform": false,
      "implementedInOfflineAudit": true,
      "additiveAcrossDisjointBatchSets": true,
      "aggregationNote": "仅不重叠批次可求和；相同批次重试不追加",
      "references": [
        {
          "table": "capture.ingestion_item",
          "columns": [
            "processing_status"
          ]
        }
      ]
    },
    {
      "code": "D3_FACT_INVENTORY",
      "name": "当前事实库存",
      "unit": "fact",
      "formula": "同一完整快照中唯一 captureId 数，不累加多次快照",
      "status": "LOCAL_ENGINEERING_ONLY",
      "definitionVersion": "d3-engineering-metrics-v0",
      "enabledInPlatform": false,
      "implementedInOfflineAudit": true,
      "additiveAcrossDisjointBatchSets": false,
      "aggregationNote": "不可直接对快照或比例求和",
      "references": [
        {
          "table": "capture.capture_event",
          "columns": [
            "id"
          ]
        }
      ]
    },
    {
      "code": "D3_QUALITY_ERRORS",
      "name": "错误问题数",
      "unit": "issue",
      "formula": "本合成协议中每条拒绝行对应一个 ERROR 问题",
      "status": "LOCAL_ENGINEERING_ONLY",
      "definitionVersion": "d3-engineering-metrics-v0",
      "enabledInPlatform": false,
      "implementedInOfflineAudit": true,
      "additiveAcrossDisjointBatchSets": true,
      "aggregationNote": "仅不重叠批次可求和；相同批次重试不追加",
      "references": [
        {
          "table": "capture.quality_issue",
          "columns": [
            "issue_code"
          ]
        }
      ]
    },
    {
      "code": "D3_QUALITY_WARNINGS",
      "name": "告警问题数",
      "unit": "issue",
      "formula": "每条处理结果的每个 WARNING 问题计一次；回放有独立行结果",
      "status": "LOCAL_ENGINEERING_ONLY",
      "definitionVersion": "d3-engineering-metrics-v0",
      "enabledInPlatform": false,
      "implementedInOfflineAudit": true,
      "additiveAcrossDisjointBatchSets": true,
      "aggregationNote": "仅不重叠批次可求和；相同批次重试不追加",
      "references": [
        {
          "table": "capture.quality_issue",
          "columns": [
            "issue_code"
          ]
        }
      ]
    },
    {
      "code": "D3_REJECTION_RATIO",
      "name": "拒绝比例",
      "unit": "ratio",
      "formula": "拒绝行数 / 处理行数；保留分子分母，分母为0返回不可用",
      "status": "LOCAL_ENGINEERING_ONLY",
      "definitionVersion": "d3-engineering-metrics-v0",
      "enabledInPlatform": false,
      "implementedInOfflineAudit": true,
      "additiveAcrossDisjointBatchSets": false,
      "aggregationNote": "不可直接对快照或比例求和",
      "references": [
        {
          "table": "capture.ingestion_item",
          "columns": [
            "processing_status"
          ]
        }
      ]
    },
    {
      "code": "SOURCE_CAPTURE_COUNT",
      "name": "源端采集量",
      "unit": "event",
      "status": "PENDING_RULE_AND_SOURCE",
      "enabledInPlatform": false,
      "implementedInOfflineAudit": false,
      "formula": null,
      "pending": [
        "P-005",
        "P-006"
      ],
      "questions": [
        "区间计数与累计计数的选择",
        "counter_epoch 重置、重叠窗口、迟到和缺口处理",
        "来源上报计数的去重与完整性"
      ],
      "references": [
        {
          "table": "capture.source_counter_sample",
          "columns": [
            "source_code",
            "source_device_key",
            "sample_key",
            "period_from",
            "period_to",
            "reported_count",
            "reported_cumulative_count",
            "counter_epoch",
            "as_of"
          ]
        }
      ]
    },
    {
      "code": "DEVICE_ONLINE_RATIO",
      "name": "设备在线率",
      "unit": "ratio",
      "status": "PENDING_RULE_AND_SOURCE",
      "enabledInPlatform": false,
      "implementedInOfflineAudit": false,
      "formula": null,
      "pending": [
        "P-006",
        "P-020"
      ],
      "questions": [
        "瞬时在线设备比例还是区间在线时长比例",
        "UNKNOWN/FAULT 和停用设备如何计入分母",
        "心跳阈值、状态策略和缺测处理"
      ],
      "references": [
        {
          "table": "core.device_status_event",
          "columns": [
            "device_id",
            "status",
            "occurred_at",
            "policy_version"
          ]
        }
      ]
    }
  ],
